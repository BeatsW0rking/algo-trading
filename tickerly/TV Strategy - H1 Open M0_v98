goLong() =>
     // Get Long via Market Order - SL below Low
    entryPrice = close
    sl_price = low - buffer
    qtyLong = calcQuantity(close, sl_price)
    strategy.entry('long_id', strategy.long, qtyLong, comment='Entry M0 of H' + str.tostring(hour(time,tz)) + ' E:' + str.tostring(entryPrice) + ' - Long. SL:' + str.tostring(sl_price))
    strategy.exit(id='long_stop_loss', from_entry='long_id', stop=sl_price)

goShort() =>
    // Get short via Market Order - SL above High
    entryPrice = close
    sl_price = high + buffer
    qtyShort = calcQuantity(close, sl_price)
    strategy.entry('short_id', strategy.short, qtyShort, comment='Entry M0 of H' + str.tostring(hour(time,tz)) + ' E:' + str.tostring(entryPrice) + ' - Short. SL:' + str.tostring(sl_price))
    strategy.exit(id='short_stop_loss', from_entry='short_id', stop=sl_price)


