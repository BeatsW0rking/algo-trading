isStratLong = strategy.position_size > 0
isStratShort = strategy.position_size < 0


if i_use_be_sl
    breakevenPriceLong = strategy.position_avg_price + syminfo.mintick //(i_initial_sl_to_be * syminfo.mintick)
    breakevenPriceShort = strategy.position_avg_price - syminfo.mintick //(i_initial_sl_to_be * syminfo.mintick)
    move_sl_to_be_long = isStratLong and close > (strategy.position_avg_price + (i_initial_sl_to_be * syminfo.mintick))
    move_sl_to_be_short = isStratShort and close < (strategy.position_avg_price - (i_initial_sl_to_be * syminfo.mintick))

    if isStratLong and move_sl_to_be_long
        strategy.cancel_all()
        if i_use_take_profit
            strategy.exit(id='longexit_TP_01', limit=(strategy.position_avg_price + (i_tp1_ticks * syminfo.mintick)), stop=breakevenPriceLong, qty_percent=tp1_pc, comment_loss='BE SL1 Hit', comment_profit='TP1 Hit')
            strategy.exit(id='longexit_TP_02', limit=(strategy.position_avg_price + (i_tp2_ticks * syminfo.mintick)), stop=breakevenPriceLong, qty_percent=tp2_pc, comment_loss='BE SL2 Hit', comment_profit='TP2 Hit')
            strategy.exit(id='longexit_TP_03', limit=(strategy.position_avg_price + (i_tp3_ticks * syminfo.mintick)), stop=breakevenPriceLong, comment_loss='BE SL3 Hit', comment_profit='TP3 Hit')
        else    
            strategy.exit(id='be_long_exit', comment='Breakeven', stop=breakevenPriceLong, qty_percent=100)     
    
    if isStratShort and move_sl_to_be_short
        strategy.cancel_all()
        if i_use_take_profit
            strategy.exit(id='shortexit_TP_01', limit=(strategy.position_avg_price - (i_tp1_ticks * syminfo.mintick)), stop=breakevenPriceShort, qty_percent=tp1_pc, comment_loss='BE SL1 Hit', comment_profit='TP1 Hit')
            strategy.exit(id='shortexit_TP_02', limit=(strategy.position_avg_price - (i_tp2_ticks * syminfo.mintick)), stop=breakevenPriceShort, qty_percent=tp2_pc, comment_loss='BE SL2 Hit', comment_profit='TP2 Hit')
            strategy.exit(id='shortexit_TP_03', limit=(strategy.position_avg_price - (i_tp3_ticks * syminfo.mintick)), stop=breakevenPriceShort, comment_loss='BE SL3 Hit', comment_profit='TP3 Hit')
        else
            strategy.exit(id='be_short_exit',  comment='Breakeven', stop=breakevenPriceShort, qty_percent=100)




