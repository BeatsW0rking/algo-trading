calcQuantity(entryPrice, stopPrice)=>
    accountBalance = strategy.equity
    riskPercent = 0.01
    riskAmount = 10 // accountBalance * riskPercent // (riskPercent / 100)

    // Get tick size for instrument and calculate stop loss distance in price terms
    tickPerPoint = 1 / syminfo.mintick
    riskPoints = math.abs(entryPrice - stopPrice) //* tickPerPoint

    // Calculate position size based on risk and stop loss distance
    orderSize = riskAmount / (riskPoints * syminfo.pointvalue)
    log.info('order size:' + str.tostring(orderSize) + ', RiskAmount: ' + str.tostring(riskAmount) + ', accountBalance:' + str.tostring(accountBalance) + ', RiskPoints: '+ str.tostring(riskPoints))
    orderSize

//     log.info('1st_m1_time: ' + str.format_time(first_m1_time, 'yyyy-MM-dd HH:mm Z') + ', O:' + str.tostring(first_m1_open)+ ', H:' + str.tostring(first_m1_high)+ ', L::' + str.tostring(first_m1_low)+ ', C:' + str.tostring(first_m1_close))
bracket_bar() =>
    // Set Long above high
    qtyLong = calcQuantity(high+buffer, low - buffer)
    qtyShort = calcQuantity(low - buffer, high+buffer)
    strategy.entry('long_id', strategy.long, qtyLong, stop=high+buffer, oca_name='bracket', oca_type=strategy.oca.cancel, comment='Bracketing M0 of H' + str.tostring(hour(time,tz)) + ' E:' + str.tostring(high+buffer) + ' - Long')
    strategy.entry('short_id', strategy.short, qtyShort, stop=low-buffer, oca_name='bracket', oca_type=strategy.oca.cancel, comment='Bracketing M0 of H'+ str.tostring(hour(time,tz)) + ' E:' + str.tostring(low-buffer) + ' - Short')

    //Long Exits
    if i_use_trailing_sl
        if i_use_take_profit
            strategy.exit(id='longexit_TP_TSL_01', from_entry="long_id", profit=i_tp1_ticks, trail_points=i_trail_points, trail_offset=i_trail_offset, qty_percent = tp1_pc, comment_trailing='TSL1 Hit', comment_profit='TP1 Hit')
            strategy.exit(id='longexit_TP_TSL_02', from_entry="long_id", profit=i_tp2_ticks, trail_points=i_trail_points, trail_offset=i_trail_offset, qty_percent = tp2_pc, comment_trailing='TSL2 Hit', comment_profit='TP2 Hit')
            strategy.exit(id='longexit_TP_TSL_03', from_entry="long_id", profit=i_tp3_ticks, trail_points=i_trail_points, trail_offset=i_trail_offset, comment_trailing='TSL3 Hit', comment_profit='TP3 Hit')
        else
            strategy.exit(id='longexit_TSL', from_entry="long_id", trail_points=i_trail_points, trail_offset=i_trail_offset)
    else if i_use_initial_sl
        if i_use_take_profit
            strategy.exit(id='longexit_TP_01', from_entry="long_id", profit=i_tp1_ticks, qty_percent=tp1_pc, stop=low - buffer, comment_loss='SL1 Hit', comment_profit='TP1 Hit')
            strategy.exit(id='longexit_TP_02', from_entry="long_id", profit=i_tp2_ticks, qty_percent=tp2_pc, stop=low - buffer, comment_loss='SL2 Hit', comment_profit='TP2 Hit')
            strategy.exit(id='longexit_TP_03', from_entry="long_id", profit=i_tp3_ticks, stop=low - buffer, comment_loss='SL3 Hit', comment_profit='TP3 Hit')
        else
            // strategy.exit(id='longexit_SL', from_entry="Long 1001", loss=i_initial_sl, qty_percent=100, comment='Initial Stop Hit')
            strategy.exit(id='long_stop_loss', from_entry='long_id', stop=low - buffer, qty_percent=100, comment='Initial Stop Hit')
    else
        if i_use_take_profit
            strategy.exit(id='longexit_TP_01', from_entry="long_id", profit=i_tp1_ticks, qty_percent=tp1_pc, comment='TP1 Hit')
            strategy.exit(id='longexit_TP_02', from_entry="long_id", profit=i_tp2_ticks, qty_percent=tp2_pc, comment='TP2 Hit')
            strategy.exit(id='longexit_TP_03', from_entry="long_id", profit=i_tp3_ticks, comment='TP3 Hit') 

    //Short Exits
    if i_use_trailing_sl
        if i_use_take_profit
            strategy.exit(id='shortexit_TP_TSL_01', from_entry="short_id", profit=i_tp1_ticks, trail_points=i_trail_points, trail_offset=i_trail_offset, qty_percent=tp1_pc, comment_trailing='TSL1 Hit', comment_profit='TP1 Hit')
            strategy.exit(id='shortexit_TP_TSL_02', from_entry="short_id", profit=i_tp2_ticks, trail_points=i_trail_points, trail_offset=i_trail_offset, qty_percent=tp2_pc, comment_trailing='TSL2 Hit', comment_profit='TP2 Hit')
            strategy.exit(id='shortexit_TP_TSL_03', from_entry="short_id", profit=i_tp3_ticks, trail_points=i_trail_points, trail_offset=i_trail_offset, comment_trailing='TSL3 Hit', comment_profit='TP3 Hit')
        else
            strategy.exit(id='shortexit_TSL', from_entry="short_id", trail_points=i_trail_points, trail_offset=i_trail_offset, comment='Trailing Stop Hit')
    else if i_use_initial_sl
        if i_use_take_profit
            strategy.exit(id='shortexit_TP_SL_01', from_entry="short_id", profit=i_tp1_ticks, qty_percent=tp1_pc, stop=high + buffer, comment_loss='SL1 Hit', comment_profit='TP1 Hit')
            strategy.exit(id='shortexit_TP_SL_02', from_entry="short_id", profit=i_tp2_ticks, qty_percent=tp2_pc, stop=high + buffer, comment_loss='SL2 Hit', comment_profit='TP2 Hit')
            strategy.exit(id='shortexit_TP_SL_03', from_entry="short_id", profit=i_tp3_ticks,  stop=high + buffer, comment_loss='SL3 Hit', comment_profit='TP3 Hit')
        else
            strategy.exit(id='shortexit_SL', from_entry="short_id", stop=high + buffer, qty_percent=100, comment='Initial Stop Hit')
    else
        if i_use_take_profit
            // log.info('tp1: ' + str.tostring(i_tp1_ticks) + 'tp1 qty: ' + str.tostring(tp1_pc)) //+ (i_tp1_ticks * syminfo.mintick))
            strategy.exit(id='shortexit_TP_01', from_entry="short_id", profit=i_tp1_ticks, qty_percent=tp1_pc, comment='TP1 Hit')
            strategy.exit(id='shortexit_TP_02', from_entry="short_id", profit=i_tp2_ticks, qty_percent=tp2_pc, comment='TP2 Hit')
            strategy.exit(id='shortexit_TP_03', from_entry="short_id", profit=i_tp3_ticks, comment='TP3 Hit')  
